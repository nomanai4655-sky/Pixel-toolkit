<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PixelToolkit — Free AI &amp; Image Tools</title>
<meta name="description" content="Free AI-powered image tools: remove backgrounds, compress images, convert formats, and make passport photos in seconds." />

<!-- Tailwind CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          paper: '#F5F6F3',
          ink: '#15161A',
          muted: '#6B6F76',
          line: '#E2E3DE',
          brand: {
            blue: '#3358FF',
            orange: '#FF5A36',
          },
        },
        fontFamily: {
          display: ['"Space Grotesk"', 'ui-sans-serif', 'sans-serif'],
          sans: ['Inter', 'ui-sans-serif', 'sans-serif'],
        },
      },
    },
  };
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', ui-sans-serif, sans-serif; }
  .font-display { font-family: 'Space Grotesk', ui-sans-serif, sans-serif; }

  /* Classic transparency checkerboard — the visual language of "background removed" */
  .bg-checker {
    background-color: #ffffff;
    background-image:
      linear-gradient(45deg, #e7e8e3 25%, transparent 25%),
      linear-gradient(-45deg, #e7e8e3 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e7e8e3 75%),
      linear-gradient(-45deg, transparent 75%, #e7e8e3 75%);
    background-size: 22px 22px;
    background-position: 0 0, 0 11px, 11px -11px, -11px 0px;
  }

  /* Hero demo: one orchestrated wipe between "messy background" and "clean cutout" */
  .wipe-reveal {
    clip-path: inset(0 0 0 0%);
    animation: wipe 7s ease-in-out infinite alternate;
  }
  .wipe-divider {
    left: 0%;
    animation: wipe-line 7s ease-in-out infinite alternate;
  }
  @keyframes wipe {
    0%   { clip-path: inset(0 0 0 0%); }
    100% { clip-path: inset(0 0 0 100%); }
  }
  @keyframes wipe-line {
    0%   { left: 100%; }
    100% { left: 0%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wipe-reveal, .wipe-divider { animation: none; clip-path: inset(0 0 0 45%); left: 55%; }
  }

  .focus-ring:focus-visible {
    outline: 2px solid #3358FF;
    outline-offset: 2px;
  }
</style>
</head>

<body class="bg-paper text-ink antialiased">

  <!-- ================= NAVBAR ================= -->
  <header class="sticky top-0 z-50 bg-paper/90 backdrop-blur border-b border-line">
    <nav class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href="#top" class="flex items-center gap-2.5 focus-ring rounded-md">
        <span class="grid grid-cols-2 grid-rows-2 gap-[3px]" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-[2px] bg-brand-blue"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-ink"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-ink"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-brand-orange"></span>
        </span>
        <span class="font-display font-semibold text-lg tracking-tight">PixelToolkit</span>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-ink/80">
        <a href="#tools" class="hover:text-ink focus-ring rounded-md">Tools</a>
        <a href="#how-it-works" class="hover:text-ink focus-ring rounded-md">How it works</a>
      </div>

      <div class="hidden md:block">
        <a href="#tools" class="inline-flex items-center rounded-lg bg-ink text-paper text-sm font-medium px-4 py-2.5 hover:bg-brand-blue transition-colors focus-ring">
          Try a tool free
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden p-2 -mr-2 focus-ring rounded-md">
        <svg id="icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </nav>

    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-paper px-5 pb-5 pt-3">
      <div class="flex flex-col gap-1 text-sm font-medium text-ink/80">
        <a href="#tools" class="py-2.5 focus-ring rounded-md">Tools</a>
        <a href="#how-it-works" class="py-2.5 focus-ring rounded-md">How it works</a>
        <a href="#tools" class="mt-2 inline-flex justify-center rounded-lg bg-ink text-paper text-sm font-medium px-4 py-2.5 focus-ring">
          Try a tool free
        </a>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ================= HERO ================= -->
    <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24">
      <div class="grid md:grid-cols-2 gap-12 md:gap-8 items-center">

        <!-- Copy -->
        <div class="max-w-xl">
          <h1 class="font-display font-semibold text-[2.5rem] leading-[1.08] sm:text-5xl sm:leading-[1.08] tracking-tight text-ink">
            Free AI &amp; Image Tools
          </h1>
          <p class="mt-5 text-base sm:text-lg text-muted leading-relaxed max-w-md">
            Remove backgrounds, shrink file sizes, switch formats, and build passport photos — all in your browser, no sign-up, no watermark.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#tools" class="inline-flex items-center rounded-lg bg-brand-blue text-white text-sm font-semibold px-5 py-3 hover:bg-ink transition-colors focus-ring">
              Explore the tools
            </a>
            <a href="#how-it-works" class="inline-flex items-center rounded-lg border border-line text-ink text-sm font-semibold px-5 py-3 hover:border-ink transition-colors focus-ring">
              See how it works
            </a>
          </div>
          <div class="mt-9 flex items-center gap-6 text-sm text-muted">
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-blue"></span>No installs</span>
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>Private by default</span>
          </div>
        </div>

        <!-- Live before/after demo -->
        <div class="relative mx-auto w-full max-w-[320px] sm:max-w-sm">
          <div class="relative aspect-[4/5] w-full rounded-2xl overflow-hidden border border-line shadow-[0_1px_0_rgba(0,0,0,0.02)]">

            <!-- Layer 1: messy background (bottom) -->
            <div class="absolute inset-0 bg-[#EDE7DD]">
              <span class="absolute w-16 h-16 rounded-full bg-brand-orange/40 -top-4 -left-4"></span>
              <span class="absolute w-10 h-10 rotate-12 bg-brand-blue/30 top-10 right-6"></span>
              <span class="absolute w-20 h-8 rounded-full bg-ink/10 bottom-16 -left-6 rotate-6"></span>
              <span class="absolute w-14 h-14 rounded-full bg-brand-blue/20 bottom-6 right-8"></span>
              <span class="absolute w-8 h-8 rotate-45 bg-brand-orange/30 bottom-24 right-2"></span>
              <!-- subject silhouette -->
              <svg viewBox="0 0 200 240" class="absolute inset-0 w-full h-full">
                <circle cx="100" cy="86" r="40" fill="#15161A" />
                <path d="M28 232 C28 164 172 164 172 232 Z" fill="#15161A" />
              </svg>
            </div>

            <!-- Layer 2: clean cutout on checkerboard (revealed via wipe) -->
            <div class="absolute inset-0 bg-checker wipe-reveal">
              <svg viewBox="0 0 200 240" class="absolute inset-0 w-full h-full">
                <circle cx="100" cy="86" r="40" fill="#15161A" />
                <path d="M28 232 C28 164 172 164 172 232 Z" fill="#15161A" />
              </svg>
            </div>

            <!-- Divider handle -->
            <div class="absolute inset-y-0 w-[2px] bg-white wipe-divider shadow-[0_0_0_1px_rgba(0,0,0,0.06)]">
              <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-7 h-7 rounded-full bg-white border border-line flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6l-4 6 4 6M16 6l4 6-4 6"/></svg>
              </span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-muted">Background Remover — live preview</p>
        </div>

      </div>
    </section>

    <!-- ================= TOOLS ================= -->
    <section id="tools" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20 border-t border-line">
      <div class="max-w-xl">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl tracking-tight">Four tools, one tab</h2>
        <p class="mt-3 text-muted leading-relaxed">Pick a tool below. Everything runs instantly and stays free.</p>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 gap-5">

        <!-- Card 1: Background Remover -->
        <article class="group relative rounded-xl border border-line bg-white p-6 transition-colors hover:border-ink">
          <div class="w-11 h-11 rounded-lg bg-brand-blue/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="6" r="2.1"/><circle cx="6" cy="18" r="2.1"/>
              <path d="M8 7.4 20 18"/><path d="M8 16.6 20 6"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display font-semibold text-lg">Background Remover</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Cut any subject out in one click and get a clean, transparent PNG.</p>
          <a href="#" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink group-hover:text-brand-blue focus-ring rounded-md">
            Remove a background
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </article>

        <!-- Card 2: Image Compressor -->
        <article class="group relative rounded-xl border border-line bg-white p-6 transition-colors hover:border-ink">
          <div class="w-11 h-11 rounded-lg bg-brand-orange/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 4v5H4"/><path d="M15 4v5h5"/><path d="M9 20v-5H4"/><path d="M15 20v-5h5"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display font-semibold text-lg">Image Compressor</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Shrink file sizes for faster uploads without losing sharpness.</p>
          <a href="#" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink group-hover:text-brand-orange focus-ring rounded-md">
            Compress an image
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </article>

        <!-- Card 3: Format Converter -->
        <article class="group relative rounded-xl border border-line bg-white p-6 transition-colors hover:border-ink">
          <div class="w-11 h-11 rounded-lg bg-brand-blue/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h13M17 8l-3-3M17 8l-3 3"/><path d="M20 16H7M7 16l3-3M7 16l3 3"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display font-semibold text-lg">Format Converter</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Switch between JPG, PNG, WebP and more with no quality loss.</p>
          <a href="#" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink group-hover:text-brand-blue focus-ring rounded-md">
            Convert a file
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </article>

        <!-- Card 4: Passport Photo Maker -->
        <article class="group relative rounded-xl border border-line bg-white p-6 transition-colors hover:border-ink">
          <div class="w-11 h-11 rounded-lg bg-brand-orange/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
              <circle cx="9.4" cy="10" r="2.1"/>
              <path d="M6 16.3c1-2.4 5.8-2.4 6.8 0"/>
              <path d="M14.2 9h3.6M14.2 12.4h3.6"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display font-semibold text-lg">Passport Photo Maker</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Auto-crop your photo to official passport and visa specifications.</p>
          <a href="#" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink group-hover:text-brand-orange focus-ring rounded-md">
            Make a passport photo
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </article>

      </div>
    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section id="how-it-works" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20 border-t border-line">
      <h2 class="font-display font-semibold text-2xl sm:text-3xl tracking-tight max-w-xl">How it works</h2>
      <div class="mt-10 grid sm:grid-cols-3 gap-8">
        <div>
          <span class="font-display text-sm text-brand-blue font-semibold">1</span>
          <h3 class="mt-2 font-semibold">Upload your image</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Drop a file or pick one from your device. JPG, PNG and WebP all work.</p>
        </div>
        <div>
          <span class="font-display text-sm text-brand-blue font-semibold">2</span>
          <h3 class="mt-2 font-semibold">Pick a tool</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Choose to remove the background, compress, convert, or crop for a passport.</p>
        </div>
        <div>
          <span class="font-display text-sm text-brand-blue font-semibold">3</span>
          <h3 class="mt-2 font-semibold">Download the result</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">Your processed image is ready in seconds, with no watermark added.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="border-t border-line">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="#top" class="flex items-center gap-2.5 focus-ring rounded-md">
        <span class="grid grid-cols-2 grid-rows-2 gap-[3px]" aria-hidden="true">
          <span class="w-2 h-2 rounded-[2px] bg-brand-blue"></span>
          <span class="w-2 h-2 rounded-[2px] bg-ink"></span>
          <span class="w-2 h-2 rounded-[2px] bg-ink"></span>
          <span class="w-2 h-2 rounded-[2px] bg-brand-orange"></span>
        </span>
        <span class="font-display font-semibold text-sm">PixelToolkit</span>
      </a>
      <p class="text-xs text-muted">© 2026 PixelToolkit. All tools are free to use.</p>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    menuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(isHidden));
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  </script>

</body>
</html>
