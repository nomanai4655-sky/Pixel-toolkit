            <div id="preset-group" class="flex flex-wrap gap-2"></div>
            <p id="size-note" class="mt-3 text-xs text-muted"></p>
          </div>

          <!-- Background Color -->
          <div class="rounded-xl border border-line bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted mb-3">2. Select Background Color</p>
            <div id="bg-group" class="flex flex-wrap items-center gap-3"></div>
          </div>
        </div>

        <!-- PREVIEW BOX -->
        <div class="space-y-4">
          <div class="rounded-xl border border-line bg-white p-5 flex flex-col items-center justify-center">
            <p class="w-full text-xs font-semibold uppercase tracking-wider text-muted mb-3">Position Adjust (Drag To Move)</p>
            <div id="crop-frame" class="w-[220px]">
              <img id="crop-img" alt="Photo to crop" draggable="false" />
              <svg id="guide-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                <ellipse cx="50" cy="44" rx="24" ry="31" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="1" stroke-dasharray="3 3" />
              </svg>
            </div>
          </div>

          <div class="rounded-xl border border-line bg-white p-5 flex flex-col items-center justify-center">
            <p class="w-full text-xs font-semibold uppercase tracking-wider text-muted mb-3">Final Result</p>
            <canvas id="preview-canvas"></canvas>
            <p id="output-dims" class="mt-3 text-xs text-muted text-center font-medium"></p>
          </div>
        </div>

      </div>

      <button
        id="download-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-brand-blue text-white text-base font-semibold px-6 py-4 hover:bg-ink transition-colors focus-ring"
      >
        <svg id="download-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/></svg>
        <span id="download-label">Download Ready Passport Photo</span>
      </button>

    </div>

  </main>

  <script>
    const DPI = 300;

    const PRESETS = [
      { id: 'pakistan', label: 'Pakistan · 35 × 45 mm', widthIn: 35 / 25.4, heightIn: 45 / 25.4 },
      { id: 'us2x2', label: 'US / UAE · 2 × 2 in', widthIn: 2, heightIn: 2 },
      { id: 'ukeu', label: 'UK / Schengen · 35 × 45 mm', widthIn: 35 / 25.4, heightIn: 45 / 25.4 },
      { id: 'india', label: 'India · 3.5 × 4.5 cm', widthIn: 3.5 / 2.54, heightIn: 4.5 / 2.54 }
    ];

    const BG_OPTIONS = [
      { id: 'passport-blue', label: 'Studio Blue', color: '#1B75BC' },
      { id: 'royal-blue', label: 'Royal Blue', color: '#0055A5' },
      { id: 'sky-blue', label: 'Sky Blue', color: '#4182E4' },
      { id: 'white', label: 'White', color: '#FFFFFF' },
      { id: 'offwhite', label: 'Off-White', color: '#F5F5F0' },
      { id: 'lightgray', label: 'Light Gray', color: '#D0D3D4' }
    ];

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const workspace = document.getElementById('workspace');
    const statusBox = document.getElementById('status-box');
    const statusText = document.getElementById('status-text');
    const errorMsg = document.getElementById('error-msg');
    const fileNameEl = document.getElementById('file-name');
    const changeBtn = document.getElementById('change-btn');
    const presetGroup = document.getElementById('preset-group');
    const bgGroup = document.getElementById('bg-group');
    const sizeNote = document.getElementById('size-note');

    const cropFrame = document.getElementById('crop-frame');
    const cropImg = document.getElementById('crop-img');
    const previewCanvas = document.getElementById('preview-canvas');
    const outputDims = document.getElementById('output-dims');
    const downloadBtn = document.getElementById('download-btn');

    let sourceImage = null;
    let originalObjectUrl = null;

    let currentPreset = PRESETS[0];
    let currentBg = BG_OPTIONS[0];

    let frameW = 0, frameH = 0;
    let scale = 1;
    let offsetX = 0, offsetY = 0;

    function showError(msg) {
      errorMsg.textContent = msg;
      errorMsg.classList.remove('hidden');
    }
    function clearError() {
      errorMsg.classList.add('hidden');
      errorMsg.textContent = '';
    }

    PRESETS.forEach(preset => {
      const btn = document.createElement('button');
      btn.textContent = preset.label;
      btn.className = 'pill-btn rounded-lg px-3.5 py-2 text-xs font-semibold focus-ring ' + (preset.id === currentPreset.id ? 'active' : '');
      btn.addEventListener('click', () => {
        currentPreset = preset;
        Array.from(presetGroup.children).forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        applyPresetAspect();
        updateOutputLabel();
        autoFitImage();
      });
      presetGroup.appendChild(btn);
    });

    BG_OPTIONS.forEach(bg => {
      const btn = document.createElement('button');
      btn.className = 'swatch focus-ring ' + (bg.id === currentBg.id ? 'active' : '');
      btn.style.backgroundColor = bg.color;
      btn.title = bg.label;
      btn.addEventListener('click', () => {
        currentBg = bg;
        Array.from(bgGroup.children).forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        cropFrame.style.background = currentBg.color;
        scheduleLivePreview();
      });
      bgGroup.appendChild(btn);
    });

    function getOutputSize() {
      return {
        w: Math.round(currentPreset.widthIn * DPI),
        h: Math.round(currentPreset.heightIn * DPI),
      };
    }

    function applyPresetAspect() {
      const { w, h } = getOutputSize();
      cropFrame.style.aspectRatio = w + ' / ' + h;
    }

    function updateOutputLabel() {
      const { w, h } = getOutputSize();
      sizeNote.textContent = w + ' × ' + h + ' px at ' + DPI + ' DPI';
      outputDims.textContent = currentPreset.label + ' (' + w + ' × ' + h + ' px)';
    }

    function autoFitImage() {
      if (!sourceImage) return;

      const rect = cropFrame.getBoundingClientRect();
      frameW = rect.width;
      frameH = rect.height;

      const nw = sourceImage.naturalWidth;
      const nh = sourceImage.naturalHeight;

      const coverScale = Math.max(frameW / nw, frameH / nh);
      scale = coverScale * 1.15;

      offsetX = 0;
      offsetY = (frameH - (nh * scale)) * 0.06;

      clampOffsets();
      applyTransform();
    }

    function clampOffsets() {
      const scaledW = sourceImage.naturalWidth * scale;
      const scaledH = sourceImage.naturalHeight * scale;
      const maxX = Math.max(0, (scaledW - frameW) / 2);
      const maxY = Math.max(0, (scaledH - frameH) / 2);
      offsetX = Math.min(maxX, Math.max(-maxX, offsetX));
      offsetY = Math.min(maxY, Math.max(-maxY, offsetY));
    }

    function applyTransform() {
      cropImg.style.width = sourceImage.naturalWidth + 'px';
      cropImg.style.height = sourceImage.naturalHeight + 'px';
      cropImg.style.transform = `translate(-50%, -50%) translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
      scheduleLivePreview();
    }

    let dragging = false, dragX = 0, dragY = 0, startOX = 0, startOY = 0;
    cropFrame.addEventListener('pointerdown', (e) => {
      if (!sourceImage) return;
      dragging = true;
      cropFrame.classList.add('dragging');
      dragX = e.clientX; dragY = e.clientY;
      startOX = offsetX; startOY = offsetY;
      cropFrame.setPointerCapture(e.pointerId);
    });
    cropFrame.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      offsetX = startOX + (e.clientX - dragX);
      offsetY = startOY + (e.clientY - dragY);
      clampOffsets();
      applyTransform();
    });
    function stopDrag() { dragging = false; cropFrame.classList.remove('dragging'); }
    cropFrame.addEventListener('pointerup', stopDrag);
    cropFrame.addEventListener('pointercancel', stopDrag);

    // AI Handle File
    async function handleFile(file) {
      clearError();
      if (!file || !file.type.startsWith('image/')) {
        showError('Please upload a valid image.');
        return;
      }

      statusBox.classList.remove('hidden');
      dropZone.classList.add('hidden');

      try {
        // Run AI Model to remove background
        const cleanBlob = await imglyRemoveBackground(file);
        
        if (originalObjectUrl) URL.revokeObjectURL(originalObjectUrl);
        originalObjectUrl = URL.createObjectURL(cleanBlob);

        const img = new Image();
        img.onload = () => {
          sourceImage = img;
          cropImg.src = img.src;
          fileNameEl.textContent = file.name;
          
          statusBox.classList.add('hidden');
          workspace.classList.remove('hidden');

          applyPresetAspect();
          updateOutputLabel();
          
          requestAnimationFrame(() => {
            autoFitImage();
          });
        };
        img.src = originalObjectUrl;
      } catch (err) {
        statusBox.classList.add('hidden');
        dropZone.classList.remove('hidden');
        showError('AI Background removal failed. Please try another image.');
      }
    }

    function renderComposite(canvas, outW, outH) {
      canvas.width = outW;
      canvas.height = outH;
      const ctx = canvas.getContext('2d');

      ctx.fillStyle = currentBg.color;
      ctx.fillRect(0, 0, outW, outH);

      if (!sourceImage || frameW <= 0) return ctx;

      const k = outW / frameW;
      const dW = sourceImage.naturalWidth * scale * k;
      const dH = sourceImage.naturalHeight * scale * k;
      const dx = outW / 2 + offsetX * k - dW / 2;
      const dy = outH / 2 + offsetY * k - dH / 2;

      ctx.drawImage(sourceImage, dx, dy, dW, dH);
      return ctx;
    }

    let scheduled = false;
    function scheduleLivePreview() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        if (!sourceImage) return;
        const { w, h } = getOutputSize();
        const max = 180;
        const pw = w >= h ? max : Math.round((max * w) / h);
        const ph = h > w ? max : Math.round((max * h) / w);
        renderComposite(previewCanvas, pw, ph);
      });
    }

    fileInput.addEventListener('change', (e) => e.target.files[0] && handleFile(e.target.files[0]));
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-active'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-active'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-active');
      if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });

    changeBtn.addEventListener('click', () => {
      workspace.classList.add('hidden');
      dropZone.classList.remove('hidden');
      fileInput.value = '';
    });

    downloadBtn.addEventListener('click', () => {
      if (!sourceImage) return;
      const { w, h } = getOutputSize();
      const canvas = document.createElement('canvas');
      renderComposite(canvas, w, h);

      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/jpeg', 0.95);
      a.download = `passport-photo-${currentPreset.id}.jpg`;
      a.click();
    });

    cropFrame.style.background = currentBg.color;
    applyPresetAspect();
    updateOutputLabel();
  </script>
</body>
