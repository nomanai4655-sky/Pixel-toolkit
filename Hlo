      </div>
      <span class="text-xs bg-brand-blue/10 text-brand-blue px-3 py-1 rounded-full font-medium">100% AI Auto-Cut</span>
    </nav>
  </header>

  <main class="max-w-4xl mx-auto px-5 py-8">

    <div class="text-center max-w-xl mx-auto mb-8">
      <h1 class="font-display font-bold text-2xl sm:text-3xl tracking-tight">Instant Passport Photo Maker</h1>
      <p class="mt-2 text-muted text-sm">Image upload karein, AI background remove karke photo ready kar dega.</p>
    </div>

    <!-- Status Message -->
    <div id="status-box" class="hidden text-sm bg-blue-50 border border-blue-200 text-blue-700 rounded-lg px-4 py-3 mb-6 flex items-center gap-3">
      <span class="spinner text-blue-600"></span>
